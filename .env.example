# Copy values into your environment, or put them in .streamlit/secrets.toml instead.
# Env vars take precedence over secrets.toml.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SUPABASE-KEY

# Optional: cookie-signing secret. If unset, one is generated and saved to .session_secret
# SESSION_SECRET=change-me
